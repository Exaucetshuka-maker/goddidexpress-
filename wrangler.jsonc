{
  "name": "goddidexpress",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "goddidexpress.com", "custom_domain": true },
    { "pattern": "www.goddidexpress.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "GDE" }
  ]
}
